# ─── Sentiment Analysis API Configuration ───────────────────

# Server
HOST=0.0.0.0
PORT=8000

# Model
MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english

# Cache
CACHE_MAXSIZE=256

# Rate Limiting
RATE_LIMIT_GENERAL=60/minute
RATE_LIMIT_ANALYZE=30/minute
RATE_LIMIT_BATCH=20/minute
RATE_LIMIT_FRAME=60/minute

# History
MAX_HISTORY=50

# Image Analysis
EMOTION_MODEL=dima806/facial_expression_image_detection
MAX_IMAGE_SIZE_MB=10
OCR_CONFIDENCE_THRESHOLD=0.3

# Logging
LOG_LEVEL=INFO
